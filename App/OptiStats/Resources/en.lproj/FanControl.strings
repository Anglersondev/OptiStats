"fan.manual.section" = "Manual control (experimental)";
"fan.allow.title" = "Allow manual control";
"fan.allow.note" = "Off by default. While off, this app never asks the helper to change a fan.";
"fan.allow.confirmTitle" = "Allow manual fan control?";
"fan.allow.confirmText" = "Setting a fan speed yourself can make the Mac louder and use more power, and it overrides macOS's own fan curve while active. macOS thermal protection remains in charge and can still throttle the chip. This was written without being tested on every chip, so run the control test first.";
