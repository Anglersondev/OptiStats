"fan.mode.automatic" = "Automatic";
"fan.mode.manual" = "Manual";
"fan.row.note" = "Choosing Automatic returns all fans to macOS. In Manual, the slider is limited to the fan's real minimum and maximum, and the value is applied when you release it.";
"fan.test.section" = "Control test (experimental)";
